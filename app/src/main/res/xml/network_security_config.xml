<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext stays off: every endpoint the app talks to is HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
